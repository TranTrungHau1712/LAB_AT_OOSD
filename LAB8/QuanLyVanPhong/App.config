<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- Đổi Data Source cho đúng máy: .\SQLEXPRESS | (localdb)\MSSQLLocalDB | tên máy\MSSQLSERVER -->
    <add name="QLVP"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QuanLyVanPhong;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
